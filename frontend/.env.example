# Copier ce fichier en `.env.local` (non versionné) pour surcharger en local.
# Toutes les variables VITE_* sont publiques : elles finissent dans le bundle JS.
# N'y mettez JAMAIS de secret.

# mock = services en mémoire (défaut) ; http = API FastAPI de la partie A
VITE_API_MODE=mock

# URL de base de l'API (utilisée seulement si VITE_API_MODE=http)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Délai d'expiration des requêtes HTTP (ms)
VITE_API_TIMEOUT_MS=10000

# Latence simulée des services mock (ms). Forcée à 0 pendant les tests.
VITE_MOCK_LATENCY_MS=300
