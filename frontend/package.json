{
  "name": "cashlens-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/ e2e/",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.46",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tsconfig/node22": "^22.0.7",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "typescript": "~5.8",
    "vite": "^6.4.6",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  }
}
